#!/bin/bash
set -euo pipefail

{{ if eq .chezmoi.os "darwin" -}}
# Install Homebrew on any OS if not found
if ! command -v brew &>/dev/null; then
	printf '\n\n\e[33mHomebrew not found. \e[0mInstalling Homebrew...\n'
	/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

	# Add brew to PATH (Linux needs this, macOS usually fine)
	if [ -d "/home/linuxbrew/.linuxbrew/bin" ]; then
		eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
	elif [ -d "/opt/homebrew/bin" ]; then
		eval "$(/opt/homebrew/bin/brew shellenv)"
	fi
else
	printf '\n\n\e[0mHomebrew found. Continuing...\n'
fi

# Update homebrew packages
printf '\nInitiating Homebrew update...\n'
brew update

brew_packages=(
{{ range .packages.darwin.brew }}
	{{ . | quote }}
{{ end }}
)

cask_packages=(
{{ range .packages.darwin.cask }}
	{{ . | quote }}
{{ end }}
)

printf '\nInstalling packages...\n'
for formula in "${brew_packages[@]}"; do
	if ! brew list --formula "$formula" &>/dev/null; then
		brew install "$formula"
	fi
done

for cask in "${cask_packages[@]}"; do
	if ! brew list --cask "$cask" &>/dev/null; then
		brew install --cask "$cask"
	fi
done

printf '\n\nRemoving out of date packages...\n'
if [ ${#brew_packages[@]} -gt 0 ] || [ ${#cask_packages[@]} -gt 0 ]; then
	brew cleanup "${brew_packages[@]}" "${cask_packages[@]}"
fi
{{ end }}

{{ if eq .chezmoi.os "linux" }}
{{ $package_install := get . "package_install" | default "system" -}}
{{ if eq $package_install "system" }}
{{ if eq .chezmoi.osRelease.id "arch" }}
sudo pacman -Sy
{{ range .packages.linux.arch.pacman }}
sudo pacman -S --needed {{ . }}
{{ end }}
{{ end }}
{{ if eq .chezmoi.osRelease.id "debian" }}
{{ range .packages.linux.ubuntu.apt }}
sudo apt-get install -y {{ . }}
{{ end }}
{{ end }}
{{ else }}
mkdir -p "${HOME}/.local/bin"

if [ ! -x "${HOME}/.local/bin/nvim" ]; then
	{{ if eq .chezmoi.arch "amd64" -}}
	nvim_arch=x86_64
	{{ else if eq .chezmoi.arch "arm64" -}}
	nvim_arch=arm64
	{{ else -}}
	printf 'Unsupported Neovim architecture: %s\n' {{ .chezmoi.arch | quote }} >&2
	exit 1
	{{ end -}}
	nvim_tmp=$(mktemp -d)
	trap 'rm -rf "$nvim_tmp"' EXIT
	curl -fsSL "https://github.com/neovim/neovim/releases/latest/download/nvim-linux-${nvim_arch}.tar.gz" |
		tar -xz -C "$nvim_tmp"
	mkdir -p "${HOME}/.local/opt"
	rm -rf "${HOME}/.local/opt/nvim"
	mv "$nvim_tmp/nvim-linux-${nvim_arch}" "${HOME}/.local/opt/nvim"
	ln -sfn "${HOME}/.local/opt/nvim/bin/nvim" "${HOME}/.local/bin/nvim"
fi

if [ ! -x "${HOME}/.local/bin/starship" ] || [ ! -x "${HOME}/.local/bin/zoxide" ] || [ ! -x "${HOME}/.local/bin/lsd" ]; then
	if ! command -v cargo &>/dev/null; then
		curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs |
			sh -s -- -y --profile minimal --no-modify-path
		export PATH="${HOME}/.cargo/bin:${PATH}"
	fi
fi

if [ ! -x "${HOME}/.local/bin/starship" ]; then
	cargo install --locked --root "${HOME}/.local" starship
fi

if [ ! -x "${HOME}/.local/bin/zoxide" ]; then
	cargo install --locked --root "${HOME}/.local" zoxide
fi

if [ ! -x "${HOME}/.local/bin/lsd" ]; then
	cargo install --locked --root "${HOME}/.local" lsd
fi
{{ end }}
{{ end }}

# Install tmux plugin manager if not exists
if [ ! -d "${HOME}/.tmux/plugins/tpm" ]; then
	git clone https://github.com/tmux-plugins/tpm "${HOME}/.tmux/plugins/tpm"
fi
